# Personal data (user fills these)
cv.md
article-digest.md
local/
# Archives — a batch/backup bundle can wrap otherwise-gitignored personal
# data (cv.md, reports/, applications.md) into one file with no per-file
# gitignore rule covering it (found live 2026-09-11: an untracked
# pipeline-batch-*.tar.gz at repo root bundled exactly that).
*.tar.gz
*.zip
# Git worktrees for isolated feature development (superpowers:using-git-worktrees)
.worktrees/
# Everything under data/ is generated or personal at runtime — only .gitkeep
# placeholders are tracked (verify with `git ls-files data/`). A blanket rule
# means a new generated file (e.g. a future log/cache addition) is covered
# for every user automatically, with no per-filename .gitignore update needed.
data/*
!data/.gitkeep
!data/offers/
!data/parser-output/
!data/tracker-additions/
!data/batch-logs/
# Received offers/contracts, promise notes, prep reports (PII — never commit)
data/offers/*
!data/offers/.gitkeep
data/parser-output/**
!data/parser-output/**/
!data/parser-output/.gitkeep
!data/parser-output/**/.gitkeep
reports/*.md
!reports/.gitkeep
output/*
!output/.gitkeep
# Historical/session archive snapshots — user-layer working data, same
# treatment as reports/output/data above, never system-layer content.
archive/*
!archive/.gitkeep
data/batch-logs/*
!data/batch-logs/.gitkeep
data/batch-state.tsv
data/batch-input.tsv
data/tracker-additions/**/*.tsv
data/batch-wave*
data/batch-*-worker.mjs
!data/tracker-additions/.gitkeep
jds/*
!jds/.gitkeep

# Personal documents — never commit scans or copies of these (PII).
# Catches common identity/credential filenames so they can't be staged by accident.
*passport*
*diploma*
*简历*
*学位*
*成绩单*

# Interview prep (accumulated STAR+R stories — user data)
interview-prep/*
!interview-prep/
!interview-prep/.gitkeep
# Session transcripts hold real interviewer names/companies — ignore content,
# ship only the system-owned scaffold (README + .gitkeep). #1242
!interview-prep/sessions/
interview-prep/sessions/*
!interview-prep/sessions/.gitkeep
!interview-prep/sessions/README.md

# Writing samples (user's personal files — never committed)
writing-samples/*
!writing-samples/README.md

# User config and customization (never auto-updated)
config/profile.yml
config/cv-facts.json
config/benchmarks.yml
config/llm-provider.yml
portals.yml
_profile.md
_custom.md
_brief.md
.update-dismissed
.update-lock
.manifesto-noted

# Plugin layer — opt-in toggles + user-installed plugins + integrity lock (never auto-updated)
config/plugins.yml
plugins.local/
plugins.lock

# Secrets (never commit — use .env.example as template)
.env
# Universal safety net — protects ALL checkouts/branches, incl. untracked subprojects
# (e.g. web/ before it graduates to main). Never commit local env files or TS build caches.
**/.env.local
**/.env*.local
**/*.tsbuildinfo

# Generated
.resolved-prompt-*
node_modules/
bun.lock
# test-all.mjs's script-runner sandbox (mkdtempSync under the repo root) — left
# behind by a suite interrupted mid-run (a flake, a Ctrl-C); ~650MB/~1000 files
# otherwise stageable by a reflexive `git add .`.
.tmp-script-test-*/
# Report-number reservation sentinels (ephemeral, created by reserve-report-num.mjs)
reports/*-RESERVED.md

# Backup files written by normalize-statuses.mjs / dedup-tracker.mjs / safe-write.ts
# (*.bak* also covers timestamped safe-write backups like cv.md.bak-2026-08-05T16-55-08-641Z
# and numbered ones like cv.md.bak10 — the old exact *.bak pattern missed both)
*.bak*

# OpenRouter runner — generated data (personal, never commit)
data/model-blacklist.json

# OS
.DS_Store
*.mov
*.mp4

# CLI-specific local config
.claude/settings.local.json
.claude/memory/
.opencode/settings.local.json
.opencode/memory/
# OpenCode project config (often holds personal MCP/model/per-machine prefs).
opencode.json
career-dashboard
career-dashboard.exe
package-lock.json
!web/package-lock.json

# Playwright MCP server run artifacts (ephemeral, machine-local)
.playwright-mcp/

# Scratch JSON payloads for CV builders (repo-relative, replaces hardcoded
# /tmp/ paths that had no reliable meaning on Windows — see modes/latex.md
# and modes/pdf.md's non-interactive invocation sections)
.tmp/

# LaTeX build cache (transient, generate-latex.mjs writes here)
.temp-latex/

# Planning (local scratchpad)
plan/

# Subagent-driven-development scratch (ledgers, briefs, review packages) —
# per-plan working state, never shipped content.
.superpowers/

# Web — runtime cache/history the dashboard writes locally; nothing here is tracked.
.career-ops-web/

# Upgrade-test fixtures are fictional system-layer data, never user data
# (see DATA_CONTRACT.md). Re-include them past the unanchored user-layer
# patterns above (cv.md, portals.yml).
!test-fixtures/**

# Workspaces (multi-tenant instances — see
# docs/superpowers/specs/2026-08-15-workspace-multitenancy-core-design.md).
# Each workspaces/{slug}/ mixes real per-tenant User Layer content (cv.md,
# config/, data/, reports/, output/, jds/, interview-prep/, writing-samples/,
# portals.yml, _profile.md, _custom.md, _brief.md, .env, workspace.json) with
# whole-directory junctions back to the already-tracked System Layer (core/,
# modes/, templates/, ...). Ignoring the whole tree does double duty: it keeps
# every tenant's personal data out of git (same policy as the root-level User
# Layer patterns above, just scoped per workspace instead of repo-wide), and
# it stops `git add -A` from walking each junction and re-staging the entire
# System Layer as "new" files under every workspace path. A tracked file can
# still be explicitly `git add`/`git mv`-ed into an ignored path if ever
# needed (git allows this) — this rule only blocks the automatic sweep.
workspaces/*
!workspaces/.gitkeep
